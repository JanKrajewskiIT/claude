{
  "version": 1,
  "editor": {
    "vimMode": false
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Shell(rg:*)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:blame*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Write(.env*)",
      "Write(**/.env*)",
      "Write(secrets/**)",
      "Write(**/secrets/**)",
      "Write(**/*.pem)",
      "Write(**/*.key)"
    ]
  }
}
